# Local-only secrets for `wrangler pages dev`. Copy to `.dev.vars` (gitignored)
# and fill in real values. NEVER commit `.dev.vars`.
# Deployed environments set these with `wrangler pages secret put <NAME>`.

# Base URL of the saturnator-api (Strapi) instance this Pages Function talks to.
STRAPI_URL=http://127.0.0.1:1337

# A Strapi "Full access" API Token (Settings -> API Tokens -> Create new API
# Token -> Token duration: Unlimited -> Token type: Full access).
# Used ONLY server-side, by this Pages Function, to resolve offers and
# record settlements. Never expose this to the browser.
STRAPI_API_TOKEN=replace-with-a-real-strapi-full-access-api-token
